{
  "name": "asterisk-ari-call-events",
  "version": "1.0.0",
  "description": "TypeScript service that consumes Asterisk ARI call events, runs a config-driven IVR and exposes live call state over HTTP/SSE. Includes a mock mode so it runs and tests without Asterisk.",
  "type": "module",
  "license": "MIT",
  "author": "Ahmed Elbashier",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "start:mock": "ARI_MODE=mock node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "eslint": "^9.39.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^3.2.7"
  }
}
